        // PERFECT DYNAMIC IFRAME AD RENDERER (Adsterra/Monetag Bypass Security Lock)
        function executeIframeAd(containerId, adScriptCode) {
            const container = document.getElementById(containerId);
            if (!container) return;
            container.innerHTML = '';

            if (!adScriptCode || adScriptCode.trim() === '') {
                container.innerHTML = '<span class="text-xs opacity-50">বিজ্ঞাপনের জন্য অ্যাডমিন প্যানেল থেকে কোড দিন</span>';
                return;
            }

            const iframe = document.createElement('iframe');
            iframe.style.width = '100%';
            iframe.style.border = 'none';
            iframe.style.overflow = 'hidden';
            iframe.style.minHeight = '60px';
            iframe.scrolling = 'no';

            container.appendChild(iframe);

            const doc = iframe.contentWindow.document;
            doc.open();
            doc.write(`
                <!DOCTYPE html>
                <html>
                <head><style>body { margin:0; padding:0; display:flex; justify-content:center; align-items:center; background:transparent; }</style></head>
                <body>${adScriptCode}</body>
                </html>
            `);
            doc.close();
        }

        function renderAds() {
            executeIframeAd('topAdContainer', adScripts.topAd);
            executeIframeAd('bottomAdContainer', adScripts.bottomAd);
        }

        function renderPosts() {
            const container = document.getElementById('postsFeedContainer');
            container.innerHTML = '';

            let filteredPosts = postsDB;
            if (selectedCategory !== "সব") {
                filteredPosts = postsDB.filter(p => p.category === selectedCategory);
            }

            if (filteredPosts.length === 0) {
                container.innerHTML = `
                    <div class="glass-card rounded-2xl p-8 text-center opacity-60">
                        <i class="fa-regular fa-folder-open text-3xl mb-2 text-cyan-400"></i>
                        <p class="text-sm">কোনো ক্যাপশন পোস্ট পাওয়া যায়নি!</p>
                    </div>
                `;
                return;
            }

            filteredPosts.forEach((post, index) => {
                if (!post.likes) post.likes = [];
                const isLiked = currentUser && post.likes.includes(currentUser.id);
                const isSelf = currentUser && post.userId === currentUser.id;

                const postCard = document.createElement('div');
                postCard.className = "glass-card rounded-3xl p-5 space-y-4 relative";

                postCard.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3 cursor-pointer" onclick="openProfile('${post.userId}')">
                            <img src="${post.userAvatar}" class="w-11 h-11 rounded-full object-cover border-2 border-cyan-500/30">
                            <div>
                                <h4 class="font-bold text-sm hover:text-cyan-400 transition">${escapeHtml(post.userName)}</h4>
                                <div class="flex items-center space-x-2 text-[11px] opacity-70">
                                    <span class="bg-cyan-500/10 text-cyan-400 px-2 py-0.5 rounded-full border border-cyan-500/20">${escapeHtml(post.category)}</span>
                                    <span>• ${post.timestamp}</span>
                                </div>
                            </div>
                        </div>

                        ${isSelf ? `
                            <button onclick="deleteUserPost('${post.id}')" class="text-xs text-rose-500 p-1.5 hover:text-rose-400" title="ডিলিট">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        ` : ''}
                    </div>

                    <p class="text-sm leading-relaxed font-normal whitespace-pre-line select-text">
                        ${escapeHtml(post.content)}
                    </p>

                    <div class="flex items-center justify-between pt-3 border-t border-gray-700/30 text-xs opacity-80">
                        <div class="flex items-center space-x-4">
                            <button onclick="toggleLike('${post.id}')" class="flex items-center space-x-1.5 ${isLiked ? 'text-rose-500 font-semibold' : 'hover:text-rose-400'} transition">
                                <i class="${isLiked ? 'fa-solid' : 'fa-regular'} fa-heart text-base"></i>
                                <span>${post.likes.length}</span>
                            </button>
                        </div>

                        <div class="flex items-center space-x-2">
                            <button onclick="copyCaption(\`${escapeJsString(post.content)}\`)" class="glass-card px-3 py-1.5 rounded-xl text-cyan-400 hover:bg-cyan-500/20 transition flex items-center gap-1.5">
                                <i class="fa-regular fa-copy"></i>
                                <span>কপি</span>
                            </button>
                            <button onclick="openChat('${post.userId}')" class="glass-card px-3 py-1.5 rounded-xl text-purple-400 hover:bg-purple-500/20 transition flex items-center gap-1.5">
                                <i class="fa-regular fa-comment-dots"></i>
                                <span>মেসেজ</span>
                            </button>
                        </div>
                    </div>
                `;

                container.appendChild(postCard);

                // Per Post Ad Injection
                const adWrapper = document.createElement('div');
                const adId = 'post_ad_' + index;
                adWrapper.id = adId;
                adWrapper.className = "per-post-ad-container my-4 text-center";
                container.appendChild(adWrapper);
                executeIframeAd(adId, adScripts.perPostAd);
            });
        }

        // CHECK EMAIL VERIFICATION MANDATE
        function checkUserVerified() {
            if (!currentUser) {
                openModal('loginModal');
                return false;
            }
            if (firebaseAuthUser && !firebaseAuthUser.emailVerified) {
                alert("আপনার জিমেইল ভেরিফাই করা হয়নি! অনুগ্রহ করে জিমেইল চেক করে পাঠানো লিংকে ক্লিক করে ভেরিফাই করে নিন।");
                return false;
            }
            return true;
        }

        function deleteUserPost(postId) {
            if (!checkUserVerified()) return;
            if (!confirm("আপনি কি পোস্টটি মুছে ফেলতে চান?")) return;
            db.ref('posts/' + postId).remove();
            showToast("পোস্টটি মুছে ফেলা হয়েছে");
        }

        function toggleLike(postId) {
            if (!checkUserVerified()) return;
            const post = postsDB.find(p => p.id === postId);
            if (!post) return;

            if (!post.likes) post.likes = [];
            const idx = post.likes.indexOf(currentUser.id);
            if (idx > -1) {
                post.likes.splice(idx, 1);
            } else {
                post.likes.push(currentUser.id);
            }

            db.ref('posts/' + postId).update({
                likes: post.likes
            });
        }

        function copyCaption(text) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showToast("ক্যাপশন কপি করা হয়েছে!");
        }

        function openCreateModal() {
            if (!checkUserVerified()) return;
            document.getElementById('createModal').classList.remove('hidden');
        }

        function submitNewPost() {
            if (!checkUserVerified()) return;

            const category = document.getElementById('postCategorySelect').value;
            const content = document.getElementById('postText').value.trim();

            if (!content) {
                showToast("ক্যাপশন টাইপ করুন!", true);
                return;
            }

            const newPostId = 'post_' + Date.now();
            const newPost = {
                id: newPostId,
                userId: currentUser.id,
                userName: currentUser.name,
                userAvatar: currentUser.avatar,
                category: category,
                content: content,
                likes: [],
                timestamp: 'এখনই'
            };

            db.ref('posts/' + newPostId).set(newPost);
            closeModal('createModal');
            document.getElementById('postText').value = '';
            showToast("আপনার ক্যাপশন পোস্ট হয়েছে!");
        }

        function openProfile(userId) {
            const targetUser = usersDB.find(u => u.id === userId) || currentUser;
            if (!targetUser) return;

            const isSelf = currentUser && targetUser.id === currentUser.id;
            const userPosts = postsDB.filter(p => p.userId === targetUser.id);
            let totalLikes = 0;
            userPosts.forEach(p => {
                if (p.likes) totalLikes += p.likes.length;
            });

            const profileContent = document.getElementById('profileContent');
            profileContent.innerHTML = `
                <div class="text-center space-y-3">
                    <img src="${targetUser.avatar}" class="w-24 h-24 rounded-full mx-auto border-4 border-cyan-500/40 shadow-xl object-cover">
                    <div>
                        <h3 class="text-xl font-bold flex items-center justify-center gap-2">
                            ${escapeHtml(targetUser.name)}
                            <i class="fa-solid fa-circle-check text-cyan-400 text-sm"></i>
                        </h3>
                        <p class="text-xs opacity-60 mt-0.5">আমাদের মেম্বার</p>
                    </div>

                    ${isSelf ? `
                        <button onclick="handleUserLogout()" class="px-5 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-semibold text-xs transition">
                            <i class="fa-solid fa-right-from-bracket mr-1"></i> লগআউট করুন
                        </button>
                    ` : `
                        <button onclick="closeModal('profileModal'); openChat('${targetUser.id}')" class="glass-card px-5 py-2 rounded-xl text-xs text-purple-400 font-semibold border border-purple-500/30">
                            <i class="fa-solid fa-paper-plane mr-1"></i> মেসেজ
                        </button>
                    `}

                    <div class="grid grid-cols-2 gap-2 pt-4">
                        <div class="glass-card p-3 rounded-2xl text-center">
                            <div class="text-lg font-bold text-cyan-400">${userPosts.length}</div>
                            <div class="text-[10px] opacity-60">মোট পোস্ট</div>
                        </div>
                        <div class="glass-card p-3 rounded-2xl text-center">
                            <div class="text-lg font-bold text-rose-400">${totalLikes}</div>
                            <div class="text-[10px] opacity-60">মোট লাইক</div>
                        </div>
                    </div>
                </div>

                <div class="mt-6 pt-6 border-t border-gray-700/50">
                    <h4 class="font-bold text-sm mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-cyan-400"></i> ${escapeHtml(targetUser.name)}-এর পোস্টসমূহ
                    </h4>
                    <div class="space-y-4">
                        ${userPosts.length === 0 ? '<p class="text-xs text-gray-500 text-center py-4">কোনো পোস্ট পাওয়া যায়নি</p>' : ''}
                        ${userPosts.map(p => `
                            <div class="glass-card p-4 rounded-2xl space-y-2 border border-gray-700/50">
                                <p class="text-xs">${escapeHtml(p.content)}</p>
                                <div class="flex items-center justify-between text-[11px] opacity-60 pt-2 border-t border-gray-700/50">
                                    <span class="text-cyan-400">${p.category}</span>
                                    <span>❤️ ${p.likes ? p.likes.length : 0}</span>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
            document.getElementById('profileModal').classList.remove('hidden');
        }

        function openChat(targetUserId) {
            if (!checkUserVerified()) return;
            const targetUser = usersDB.find(u => u.id === targetUserId);
            if (!targetUser) return;

            activeChatUserId = targetUserId;
            document.getElementById('chatUserName').innerText = targetUser.name;
            document.getElementById('chatUserAvatar').src = targetUser.avatar;

            renderChatMessages();
            document.getElementById('messagesModal').classList.remove('hidden');
        }

        function renderChatMessages() {
            if (!activeChatUserId) return;
            const chatContainer = document.getElementById('chatMessages');
            chatContainer.innerHTML = '';

            const conversation = messagesDB.filter(m =>
                (m.senderId === currentUser.id && m.receiverId === activeChatUserId) ||
                (m.senderId === activeChatUserId && m.receiverId === currentUser.id)
            );

            if (conversation.length === 0) {
                chatContainer.innerHTML = `<div class="text-center text-xs opacity-50 py-8">কথোপকথন শুরু করতে বার্তা লিখুন...</div>`;
                return;
            }

            conversation.forEach(m => {
                const isMe = m.senderId === currentUser.id;
                const msgBubble = document.createElement('div');
                msgBubble.className = `flex ${isMe ? 'justify-end' : 'justify-start'}`;
                msgBubble.innerHTML = `
                    <div class="max-w-[75%] rounded-2xl px-4 py-2.5 text-xs ${
                        isMe ? 'btn-glow text-white rounded-br-none' : 'glass-card border border-gray-700/50 rounded-bl-none'
                    }">
                        <p>${escapeHtml(m.text)}</p>
                        <span class="text-[9px] opacity-70 block text-right mt-1">${m.time}</span>
                    </div>
                `;
                chatContainer.appendChild(msgBubble);
            });
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function sendDirectMessage() {
            if (!checkUserVerified()) return;
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if (!text || !activeChatUserId) return;

            const msgId = 'msg_' + Date.now();
            const newMsg = {
                id: msgId,
                senderId: currentUser.id,
                receiverId: activeChatUserId,
                text: text,
                time: new Date().toLocaleTimeString([], {
                    hour: '2-digit',
                    minute: '2-digit'
                })
            };

            db.ref('messages/' + msgId).set(newMsg);
            input.value = '';
        }

        // ADMIN PANEL
        function openAdminModal() {
            document.getElementById('adminPasswordInput').value = '';
            document.getElementById('adminLoginModal').classList.remove('hidden');
        }

        function verifyAdminLogin() {
            const pass = document.getElementById('adminPasswordInput').value.trim();
            if (pass === SECRET_ADMIN_PASS) {
                closeModal('adminLoginModal');
                loadAdminDashboard();
                document.getElementById('adminDashboardModal').classList.remove('hidden');
                showToast("এডমিন হিসেবে লগইন সফল!");
            } else {
                showToast("ভুল পাসওয়ার্ড!", true);
            }
        }

        function loadAdminDashboard() {
            document.getElementById('adminInputName').value = adminProfile.name || '';
            document.getElementById('adminInputFb').value = adminProfile.facebook || '';
            document.getElementById('adminInputTt').value = adminProfile.tiktok || '';
            document.getElementById('adminInputYt').value = adminProfile.youtube || '';

            renderAdminPosts();
            renderAdminUsers();
            renderAdminChatThreads();
            renderAdminCategories();
            document.getElementById('scriptTopAd').value = adScripts.topAd || '';
            document.getElementById('scriptPerPostAd').value = adScripts.perPostAd || '';
            document.getElementById('scriptBottomAd').value = adScripts.bottomAd || '';
        }

        function switchAdminTab(tab) {
            ['Posts', 'Users', 'Messages', 'Popup', 'Categories', 'Ads'].forEach(t => {
                const el = document.getElementById(`adminTab${t}`);
                if (el) el.classList.add('hidden');
            });

            ['Posts', 'Users', 'MsgMonitor', 'Popup', 'Categories', 'Ads'].forEach(btn => {
                const b = document.getElementById(`tabBtn${btn}`);
                if (b) b.className = "px-4 py-2 rounded-xl text-xs font-semibold text-gray-400";
            });

            const activeBtn = document.getElementById(`tabBtn${tab === 'messages' ? 'MsgMonitor' : (tab.charAt(0).toUpperCase() + tab.slice(1))}`);
            if (activeBtn) activeBtn.className = "px-4 py-2 rounded-xl text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30";

            const activeTabEl = document.getElementById(`adminTab${tab.charAt(0).toUpperCase() + tab.slice(1)}`);
            if (activeTabEl) activeTabEl.classList.remove('hidden');
        }

        function renderAdminPosts() {
            const container = document.getElementById('adminPostsList');
            container.innerHTML = '';

            postsDB.forEach(post => {
                const card = document.createElement('div');
                card.className = "glass-card p-3 rounded-2xl flex items-center justify-between text-xs border border-gray-700/50";
                card.innerHTML = `
                    <div class="flex items-center space-x-3 flex-1 overflow-hidden pr-2">
                        <img src="${post.userAvatar}" class="w-8 h-8 rounded-full flex-shrink-0">
                        <div class="truncate">
                            <div class="font-bold">${escapeHtml(post.userName)} <span class="text-[10px] text-cyan-400">(${post.category})</span></div>
                            <div class="opacity-80 truncate">${escapeHtml(post.content)}</div>
                        </div>
                    </div>
                    <button onclick="adminDeletePost('${post.id}')" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-500 text-white rounded-lg text-[10px]">
                        <i class="fa-solid fa-trash"></i> ডিলিট
                    </button>
                `;
                container.appendChild(card);
            });
        }

        function adminDeletePost(postId) {
            if (!confirm("পোস্টটি ডিলিট করতে চান?")) return;
            db.ref('posts/' + postId).remove();
            showToast("পোস্ট ডিলিট হয়েছে");
        }

        function renderAdminUsers() {
            const container = document.getElementById('adminUsersList');
            container.innerHTML = '';

            usersDB.forEach(u => {
                const userPostsCount = postsDB.filter(p => p.userId === u.id).length;
                const div = document.createElement('div');
                div.className = "glass-card p-3 rounded-2xl flex items-center justify-between text-xs border border-gray-700/50";
                div.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <img src="${u.avatar}" class="w-9 h-9 rounded-full object-cover">
                        <div>
                            <div class="font-bold flex items-center gap-2">${escapeHtml(u.name)}</div>
                            <div class="text-[11px] text-amber-400 font-mono">${escapeHtml(u.email)}</div>
                            <div class="text-[10px] opacity-60">পোস্ট: ${userPostsCount} টি</div>
                        </div>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function renderAdminChatThreads() {
            const container = document.getElementById('adminChatThreadsList');
            container.innerHTML = '';

            let pairs = [];
            messagesDB.forEach(m => {
                const pKey = [m.senderId, m.receiverId].sort().join('_');
                if (!pairs.includes(pKey)) pairs.push(pKey);
            });

            if (pairs.length === 0) {
                container.innerHTML = `<p class="text-xs opacity-50 py-4 text-center">কোনো মেসেজ নেই</p>`;
                return;
            }

            pairs.forEach(pKey => {
                const [u1Id, u2Id] = pKey.split('_');
                const u1 = usersDB.find(u => u.id === u1Id) || {
                    name: 'Unknown'
                };
                const u2 = usersDB.find(u => u.id === u2Id) || {
                    name: 'Unknown'
                };

                const btn = document.createElement('button');
                btn.className = "w-full text-left glass-card p-2.5 rounded-xl text-xs transition";
                btn.innerHTML = `<div class="font-bold text-cyan-400 truncate">${escapeHtml(u1.name)} ↔ ${escapeHtml(u2.name)}</div>`;
                btn.onclick = () => loadAdminFullChatThread(u1Id, u2Id);
                container.appendChild(btn);
            });
        }

        function loadAdminFullChatThread(u1Id, u2Id) {
            const fullBox = document.getElementById('adminChatFullBox');
            fullBox.innerHTML = '';

            const conversation = messagesDB.filter(m =>
                (m.senderId === u1Id && m.receiverId === u2Id) ||
                (m.senderId === u2Id && m.receiverId === u1Id)
            );

            conversation.forEach(m => {
                const sender = usersDB.find(u => u.id === m.senderId) || {
                    name: 'Unknown'
                };
                const div = document.createElement('div');
                div.className = "glass-card p-2 rounded-xl text-xs border border-gray-700/50";
                div.innerHTML = `
                    <div class="flex justify-between text-[10px] opacity-60 mb-1">
                        <span class="font-bold text-amber-400">${escapeHtml(sender.name)}</span>
                        <span>${m.time}</span>
                    </div>
                    <p>${escapeHtml(m.text)}</p>
                `;
                fullBox.appendChild(div);
            });
        }

        function adminSavePopupSettings() {
            adminProfile.name = document.getElementById('adminInputName').value.trim();
            adminProfile.facebook = document.getElementById('adminInputFb').value.trim();
            adminProfile.tiktok = document.getElementById('adminInputTt').value.trim();
            adminProfile.youtube = document.getElementById('adminInputYt').value.trim();

            const fileInput = document.getElementById('adminFileInput');
            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    adminProfile.avatar = e.target.result;
                    db.ref('config/adminProfile').set(adminProfile);
                    showToast("এডমিন ছবি ও সোশ্যাল লিংক সেভ হয়েছে!");
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                db.ref('config/adminProfile').set(adminProfile);
                showToast("পপআপ সেটিংস সেভ করা হয়েছে!");
            }
        }

        function renderAdminCategories() {
            const container = document.getElementById('adminCategoryList');
            container.innerHTML = '';

            categoriesDB.forEach(cat => {
                const div = document.createElement('div');
                div.className = "glass-card p-3 rounded-xl flex items-center justify-between border border-gray-700/50";
                div.innerHTML = `
                    <span class="text-xs font-semibold">${cat}</span>
                    ${cat !== 'সব' ? `
                        <button onclick="adminDeleteCategory('${cat}')" class="text-rose-400 hover:text-rose-300 text-xs p-1">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    ` : '<span class="text-[10px] opacity-50">ডিফল্ট</span>'}
                `;
                container.appendChild(div);
            });
        }

        function adminAddCategory() {
            const input = document.getElementById('newCategoryInput');
            const catName = input.value.trim();
            if (!catName || categoriesDB.includes(catName)) return;

            categoriesDB.push(catName);
            db.ref('categories').set(categoriesDB);
            input.value = '';
            showToast(`'${catName}' যুক্ত করা হয়েছে`);
        }

        function adminDeleteCategory(catName) {
            categoriesDB = categoriesDB.filter(c => c !== catName);
            if (selectedCategory === catName) selectedCategory = "সব";
            db.ref('categories').set(categoriesDB);
            showToast(`'${catName}' মুছে ফেলা হয়েছে`);
        }

        function adminSaveAds() {
            adScripts.topAd = document.getElementById('scriptTopAd').value;
            adScripts.perPostAd = document.getElementById('scriptPerPostAd').value;
            adScripts.bottomAd = document.getElementById('scriptBottomAd').value;

            db.ref('config/adScripts').set(adScripts);
            showToast("এডস কোড সেভ করা হয়েছে!");
        }

        function switchTab(tab) {
            if (tab === 'messages') {
                if (!checkUserVerified()) return;
                if (usersDB.length > 1) {
                    const otherUser = usersDB.find(u => u.id !== currentUser.id);
                    if (otherUser) openChat(otherUser.id);
                } else {
                    showToast("মেসেজ পাঠাতে অন্য ইউজারের উপস্থিতি প্রয়োজন");
                }
            }
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function showToast(msg, isError = false) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.innerText = msg;
            toastIcon.className = isError ? "fa-solid fa-circle-exclamation text-rose-500 text-base" : "fa-solid fa-circle-check text-cyan-400 text-base";

            toast.classList.remove('translate-x-full');
            setTimeout(() => {
                toast.classList.add('translate-x-full');
            }, 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function escapeJsString(str) {
            if (!str) return '';
            return str.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\${/g, '\\${');
        }
    </script>
</body>

</html>
