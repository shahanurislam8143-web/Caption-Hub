        // Realtime Database Listeners
        function initFirebaseSync() {
            db.ref('posts').on('value', (snapshot) => {
                const data = snapshot.val();
                postsDB = data ? Object.values(data) : [];
                renderPosts();
            });

            db.ref('users').on('value', (snapshot) => {
                const data = snapshot.val();
                usersDB = data ? Object.values(data) : [];
            });

            db.ref('categories').on('value', (snapshot) => {
                const data = snapshot.val();
                if (data) categoriesDB = data;
                renderCategories();
            });

            db.ref('config').on('value', (snapshot) => {
                const data = snapshot.val();
                if (data) {
                    if (data.adminProfile) adminProfile = data.adminProfile;
                    if (data.adScripts) adScripts = data.adScripts;
                    setupFollowAdminPopupData();
                    renderAds();
                }
            });

            db.ref('messages').on('value', (snapshot) => {
                const data = snapshot.val();
                messagesDB = data ? Object.values(data) : [];
                if (activeChatUserId) renderChatMessages();
            });
        }

        window.onload = function() {
            initFirebaseSync();
            setTimeout(() => {
                document.getElementById('followAdminModal').classList.remove('hidden');
