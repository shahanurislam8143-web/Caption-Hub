<!DOCTYPE html>
<html lang="bn" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3D Glassmorphism Caption App Pro - OurDinajpur</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            400: '#38bdf8',
                            500: '#06b6d4',
                            600: '#0284c7',
                            900: '#0f172a'
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Firebase SDKs (v9 Compat) -->
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

    <style>
        * {
            font-family: 'Hind Siliguri', sans-serif;
        }

        /* Dark & Light Background Styles */
        html.dark body {
            background-color: #080c14 !important;
            color: #f3f4f6 !important;
        }

        html:not(.dark) body {
            background-color: #e2e8f0 !important;
            color: #0f172a !important;
        }

        /* Dark Mode Glass */
        html.dark .glass-card {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        html.dark .glass-nav {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        html.dark .glass-input {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
        }

        /* Light Mode Glass */
        html:not(.dark) .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        html:not(.dark) .glass-nav {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(203, 213, 225, 0.8);
        }

        html:not(.dark) .glass-input {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(203, 213, 225, 1);
            color: #0f172a;
        }

        .btn-glow {
            background: linear-gradient(135deg, #0284c7 0%, #06b6d4 100%);
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.4);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body class="pb-24 pt-16 transition-colors duration-300">

    <!-- Top Navigation Bar -->
    <nav class="fixed top-0 left-0 right-0 z-40 glass-nav px-4 py-3">
        <div class="max-w-4xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('feed')">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/30">
                    <i class="fa-solid font-bold text-xl text-white">C</i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 to-blue-400">
                        Caption Universe
                    </h1>
                    <p class="text-[10px] text-gray-400 tracking-wider">OurDinajpur Verified</p>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <!-- Theme Switcher -->
                <button onclick="toggleTheme()" class="p-2.5 rounded-xl glass-card text-amber-400 hover:text-amber-300 transition" title="ডার্ক/লাইট থিম">
                    <i id="themeIcon" class="fa-solid fa-sun text-lg"></i>
                </button>

                <!-- Auth Section -->
                <div id="userAuthSection">
                    <!-- Rendered via JS -->
                </div>

                <!-- Admin Button -->
                <button onclick="openAdminModal()" class="p-2 rounded-xl glass-card text-amber-400 hover:text-amber-300 transition" title="এডমিন প্যানেল">
                    <i class="fa-solid fa-user-shield text-lg"></i>
                </button>
            </div>
        </div>
    </nav>

    <!-- Top Banner Ad Container -->
    <div class="max-w-4xl mx-auto px-4 mt-4">
        <div id="topAdContainer" class="glass-card rounded-2xl p-2 text-center overflow-hidden min-h-[60px] flex items-center justify-center">
            <span class="text-xs opacity-60">Top Ad Banner Space</span>
        </div>
    </div>

    <!-- Main Content Feed -->
    <main class="max-w-4xl mx-auto px-4 mt-4">
        <div class="mb-6 overflow-x-auto no-scrollbar flex items-center space-x-2 py-2" id="categoryFilterContainer">
            <!-- Categories -->
        </div>

        <div class="glass-card rounded-2xl p-4 mb-6 relative overflow-hidden">
            <div class="flex items-center space-x-3">
                <img id="createPostAvatar" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Guest" class="w-10 h-10 rounded-full bg-slate-800 object-cover">
                <button onclick="openCreateModal()" class="w-full text-left glass-input rounded-xl px-4 py-2.5 text-sm text-gray-400 transition">
                    আপনার পছন্দের ক্যাপশন শেয়ার করুন...
                </button>
            </div>
        </div>

        <div id="postsFeedContainer" class="space-y-6">
            <!-- Posts -->
        </div>
    </main>

    <!-- Bottom Sticky Ad Container -->
    <div class="fixed bottom-16 left-0 right-0 z-30 px-4 pointer-events-none">
        <div class="max-w-4xl mx-auto pointer-events-auto">
            <div id="bottomAdContainer" class="glass-nav rounded-2xl p-2 text-center shadow-2xl overflow-hidden flex items-center justify-center min-h-[50px]">
                <span class="text-xs opacity-60">Bottom Sticky Ad Banner</span>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <div class="fixed bottom-0 left-0 right-0 z-40 glass-nav border-t border-gray-800/20 px-6 py-2">
        <div class="max-w-md mx-auto flex items-center justify-between">
            <button onclick="switchTab('feed')" class="flex flex-col items-center space-y-1 text-cyan-400 hover:text-cyan-300">
                <i class="fa-solid fa-house text-lg"></i>
                <span class="text-[10px]">ফিড</span>
            </button>
            <button onclick="openCreateModal()" class="w-12 h-12 -mt-5 rounded-full btn-glow text-white flex items-center justify-center text-xl shadow-lg border-2 border-cyan-300/30">
                <i class="fa-solid fa-plus"></i>
            </button>
            <button onclick="switchTab('messages')" class="flex flex-col items-center space-y-1 text-gray-400 hover:text-cyan-400">
                <i class="fa-solid fa-comments text-lg"></i>
                <span class="text-[10px]">মেসেজ</span>
            </button>
            <button onclick="handleNavProfileClick()" class="flex flex-col items-center space-y-1 text-gray-400 hover:text-cyan-400">
                <i class="fa-solid fa-user text-lg"></i>
                <span class="text-[10px]">প্রোফাইল</span>
            </button>
        </div>
    </div>

    <!-- ================= MODALS & VIEWS ================= -->

    <!-- USER REGISTRATION & LOGIN MODAL -->
    <div id="loginModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="glass-card rounded-3xl w-full max-w-sm p-6 relative border border-cyan-500/40">
            <button onclick="closeModal('loginModal')" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <!-- Mode Switch Tabs -->
            <div class="flex space-x-2 border-b border-gray-700 pb-3 mb-4">
                <button id="tabAuthLogin" onclick="switchAuthMode('login')" class="flex-1 py-1 text-xs font-bold text-cyan-400 border-b-2 border-cyan-400">লগইন</button>
                <button id="tabAuthRegister" onclick="switchAuthMode('register')" class="flex-1 py-1 text-xs font-bold text-gray-400">রেজিস্ট্রেশন</button>
            </div>

            <!-- LOGIN FORM -->
            <form id="formLogin" onsubmit="handleUserLogin(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold mb-1">জিমেইল ইমেইল</label>
                    <input type="email" id="loginEmail" required placeholder="yourname@gmail.com" class="w-full glass-input rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-semibold mb-1">পাসওয়ার্ড</label>
                    <input type="password" id="loginPass" required placeholder="******" class="w-full glass-input rounded-xl px-3 py-2 text-xs">
                </div>
                <button type="submit" class="w-full btn-glow py-2.5 rounded-xl text-xs font-bold text-white">লগইন করুন</button>
            </form>

            <!-- REGISTER FORM -->
            <form id="formRegister" onsubmit="handleUserRegister(event)" class="space-y-3 hidden">
                <div>
                    <label class="block text-xs font-semibold mb-1">আপনার নাম</label>
                    <input type="text" id="regName" required placeholder="তানভীর হাসান" class="w-full glass-input rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-semibold mb-1">আপনার আসল জিমেইল</label>
                    <input type="email" id="regEmail" required placeholder="yourname@gmail.com" class="w-full glass-input rounded-xl px-3 py-2 text-xs">
                </div>
                <div>
                    <label class="block text-xs font-semibold mb-1">গোপন পাসওয়ার্ড</label>
                    <input type="password" id="regPass" required minlength="6" placeholder="কমপক্ষে ৬ ডিজিট" class="w-full glass-input rounded-xl px-3 py-2 text-xs">
                </div>
                <p class="text-[10px] text-amber-400 leading-tight">⚠️ রেজিস্ট্রেশন করার পর আপনার জিমেইলে একটি ভেরিফিকেশন লিংক যাবে। লিংকে ক্লিক করে ভেরিফাই করলেই কেবল পোস্ট বা কমেন্ট করতে পারবেন!</p>
                <button type="submit" class="w-full btn-glow py-2.5 rounded-xl text-xs font-bold text-white">সাইন আপ ও লিংক পাঠান</button>
            </form>
        </div>
    </div>

    <!-- FOLLOW ADMIN POPUP -->
    <div id="followAdminModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="glass-card rounded-3xl w-full max-w-sm p-6 relative border border-cyan-500/40 text-center space-y-4 shadow-2xl">
            <button onclick="closeModal('followAdminModal')" class="absolute top-4 right-4 text-gray-400 hover:text-white p-1">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>

            <div class="relative w-20 h-20 mx-auto">
                <img id="adminPopupAvatar" src="" class="w-20 h-20 rounded-full object-cover border-2 border-cyan-400 shadow-lg shadow-cyan-500/30">
                <span class="absolute bottom-0 right-1 w-4 h-4 bg-emerald-400 border-2 border-slate-900 rounded-full"></span>
            </div>

            <div>
                <h3 id="adminPopupName" class="font-bold text-lg"></h3>
                <p class="text-xs text-cyan-400 font-medium">অফিসিয়াল এডমিন প্রোফাইল</p>
            </div>

            <p class="text-xs leading-relaxed opacity-80 p-3 rounded-2xl border border-gray-700/50">
                আমাদের অফিশিয়াল সোশ্যাল মিডিয়া পেজগুলোতে যুক্ত হয়ে প্রতিনিয়ত নতুন ক্যাপশন ও আপডেট পেতে এডমিনকে ফলো করে রাখুন!
            </p>

            <div class="space-y-2 pt-1">
                <a id="adminFbBtn" href="#" target="_blank" class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs flex items-center justify-center space-x-2 transition">
                    <i class="fa-brands fa-facebook text-base"></i>
                    <span>Facebook এ ফলো করুন</span>
                </a>
                <a id="adminTtBtn" href="#" target="_blank" class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-black text-white border border-gray-700 font-semibold text-xs flex items-center justify-center space-x-2 transition">
                    <i class="fa-brands fa-tiktok text-base text-pink-400"></i>
                    <span>TikTok এ ফলো করুন</span>
                </a>
                <a id="adminYtBtn" href="#" target="_blank" class="w-full py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-semibold text-xs flex items-center justify-center space-x-2 transition">
                    <i class="fa-brands fa-youtube text-base"></i>
                    <span>YouTube সাবস্ক্রাইব করুন</span>
                </a>
            </div>
        </div>
    </div>

    <!-- CREATE POST MODAL -->
    <div id="createModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-md hidden">
        <div class="glass-card rounded-3xl w-full max-w-lg p-6 relative border border-cyan-500/30">
            <div class="flex items-center justify-between pb-4 border-b border-gray-700/50">
                <h3 class="font-bold text-lg flex items-center gap-2">
                    <i class="fa-solid fa-pen-nib text-cyan-400"></i> <span>নতুন ক্যাপশন পোস্ট</span>
                </h3>
                <button onclick="closeModal('createModal')" class="text-gray-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="space-y-4 mt-4">
                <div>
                    <label class="block text-xs font-medium mb-1">ক্যাটাগরি সিলেক্ট করুন</label>
                    <select id="postCategorySelect" class="w-full glass-input rounded-xl px-4 py-2.5 text-sm"></select>
                </div>

                <div>
                    <label class="block text-xs font-medium mb-1">ক্যাপশন লিখুন</label>
                    <textarea id="postText" rows="4" placeholder="এখানে আপনার পছন্দনীয় ক্যাপশন লিখুন..." class="w-full glass-input rounded-xl p-3 text-sm resize-none"></textarea>
                </div>

                <div class="flex justify-end space-x-3 pt-2">
                    <button onclick="closeModal('createModal')" class="px-5 py-2 rounded-xl text-sm text-gray-400">বাতিল</button>
                    <button onclick="submitNewPost()" class="btn-glow px-6 py-2 rounded-xl text-sm font-semibold text-white">পাবলিশ করুন</button>
                </div>
            </div>
        </div>
    </div>

    <!-- USER PROFILE MODAL -->
    <div id="profileModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden overflow-y-auto">
        <div class="glass-card rounded-3xl w-full max-w-xl p-6 relative border border-cyan-500/30 max-h-[90vh] overflow-y-auto my-auto">
            <button onclick="closeModal('profileModal')" class="absolute top-4 right-4 text-gray-400 hover:text-white p-2 z-10">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div id="profileContent"></div>
        </div>
    </div>

    <!-- CHAT MODAL -->
    <div id="messagesModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="glass-card rounded-3xl w-full max-w-2xl h-[80vh] flex flex-col border border-cyan-500/30 overflow-hidden">
            <div class="p-4 border-b border-gray-700/50 flex items-center justify-between bg-slate-900/50">
                <div class="flex items-center space-x-3">
                    <button onclick="closeModal('messagesModal')" class="text-gray-400 hover:text-white mr-2">
                        <i class="fa-solid fa-arrow-left text-lg"></i>
                    </button>
                    <img id="chatUserAvatar" src="" class="w-10 h-10 rounded-full object-cover">
                    <div>
                        <h4 id="chatUserName" class="font-bold text-sm"></h4>
                        <p class="text-[10px] text-cyan-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span> অনলাইন
                        </p>
                    </div>
                </div>
            </div>
            <div id="chatMessages" class="flex-1 p-4 overflow-y-auto space-y-3"></div>
            <div class="p-3 border-t border-gray-700/50 flex items-center space-x-2">
                <input id="chatInput" type="text" placeholder="মেসেজ লিখুন..." class="flex-1 glass-input rounded-xl px-4 py-2 text-sm">
                <button onclick="sendDirectMessage()" class="btn-glow p-2.5 rounded-xl text-white">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ADMIN LOGIN MODAL -->
    <div id="adminLoginModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden">
        <div class="glass-card rounded-3xl w-full max-w-md p-6 relative border border-amber-500/40">
            <div class="text-center mb-6">
                <div class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center mx-auto mb-3 text-2xl shadow-lg shadow-amber-500/20">
                    <i class="fa-solid fa-user-lock"></i>
                </div>
                <h3 class="font-bold text-xl">এডমিন লগইন</h3>
                <p class="text-xs text-gray-400 mt-1">এডমিন প্যানেলে প্রবেশ করতে সিক্রেট পাসওয়ার্ড দিন</p>
            </div>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-medium mb-1">এডমিন পাসওয়ার্ড (Secret Key)</label>
                    <input type="password" id="adminPasswordInput" placeholder="পাসওয়ার্ড দিন..." class="w-full glass-input rounded-xl px-4 py-2.5 text-sm">
                </div>
                <div class="flex space-x-3 pt-2">
                    <button onclick="closeModal('adminLoginModal')" class="w-1/2 py-2.5 rounded-xl text-sm text-gray-400">বাতিল</button>
                    <button onclick="verifyAdminLogin()" class="w-1/2 bg-gradient-to-r from-amber-500 to-orange-600 text-white font-semibold py-2.5 rounded-xl text-sm shadow-lg shadow-amber-500/30">লগইন</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN ADMIN DASHBOARD MODAL -->
    <div id="adminDashboardModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden overflow-y-auto">
        <div class="glass-card rounded-3xl w-full max-w-4xl p-6 relative border border-amber-500/40 max-h-[90vh] overflow-y-auto my-auto">
            <div class="flex items-center justify-between pb-4 border-b border-gray-700/50 mb-6">
                <div class="flex items-center space-x-3">
                    <span class="px-3 py-1 rounded-full bg-amber-500/20 text-amber-400 text-xs border border-amber-500/30 font-semibold">OURDINAJPUR ADMIN</span>
                    <h3 class="font-bold text-lg">এডমিন কন্ট্রোল প্যানেল</h3>
                </div>
                <button onclick="closeModal('adminDashboardModal')" class="text-gray-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div class="flex space-x-2 border-b border-gray-700/50 pb-3 mb-6 overflow-x-auto no-scrollbar">
                <button onclick="switchAdminTab('posts')" id="tabBtnPosts" class="px-4 py-2 rounded-xl text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">পোস্ট ম্যানেজমেন্ট</button>
                <button onclick="switchAdminTab('users')" id="tabBtnUsers" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400">ইউজার কন্ট্রোল & ব্যান</button>
                <button onclick="switchAdminTab('messages')" id="tabBtnMsgMonitor" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400">ফুল মেসেজ মনিটর</button>
                <button onclick="switchAdminTab('popup')" id="tabBtnPopup" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400">পপআপ & ছবি আপলোড</button>
                <button onclick="switchAdminTab('categories')" id="tabBtnCategories" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400">ক্যাটাগরি</button>
                <button onclick="switchAdminTab('ads')" id="tabBtnAds" class="px-4 py-2 rounded-xl text-xs font-semibold text-gray-400">এডস কোড</button>
            </div>

            <div id="adminTabPosts" class="space-y-4">
                <h4 class="text-sm font-bold text-cyan-400 flex items-center gap-2"><i class="fa-solid fa-layer-group"></i> সকল পোস্ট এডিট ও কন্ট্রোল</h4>
                <div id="adminPostsList" class="space-y-3 max-h-80 overflow-y-auto pr-1"></div>
            </div>

            <div id="adminTabUsers" class="space-y-4 hidden">
